mixin icon(name)
    case name
        when 'a'
            <svg viewBox="0 0 40 40"><text x="20" y="30" text-anchor="middle" font-size="32" font-weight="bold" font-family="Georgia, serif" fill="currentColor">A</text></svg>
        when 'code'
            <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M14 12L6 20l8 8M26 12l8 8-8 8M23 9l-6 22"/></svg>
        when 'support'
            <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3"><circle cx="20" cy="20" r="14"/><circle cx="20" cy="20" r="6"/><path d="M10 10l6 6M30 10l-6 6M10 30l6-6M30 30l-6-6"/></svg>

mixin menu(items)
    button.burger(type="button", aria-label="Open menu", aria-expanded="false")
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    div.navigation
        button.x(type="button", aria-label="Close menu")
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
        div.lopata
            nav
                ul.menu
                    each item in items
                        li
                            a(href=item.link)= item.name

mixin service(info)
    article.service
        div.service_icon(class=info.active ? 'active' : '')
            +icon(info.icon)
        h3.service_title= info.title
        p.service_text Lorem ipsum dolor sit amet, consectetur adipisicing elit. Minima maxime quam architecto quo inventore harum ex magni, dicta impedit. Lorem ipsum.

mixin member(info)
    article.team_member
        img.team_photo(src=`assets/images/${info.img}`, alt=info.name)
        h3.team_name= info.name
        p.team_role= info.role

mixin work(info)
    a.work(href="#")
        img(src=`assets/images/${info.img}`, alt=info.title)
        div.work_hover
            h3.work_title= info.title
            p.work_cat= info.category
            span.work_view View &rsaquo;

mixin post(info, date)
    article.post
        img.post_img(src=`assets/images/${info.img}`, alt=info.title)
        div
            div.post_head
                div.post_date
                    b= date.day
                    span= date.month
                div
                    h3.post_title
                        a(href="#")= info.title
                    p.post_meta
                        | By 
                        a(href="#")= info.author
                        |  in 
                        a(href="#")= info.category
            p.post_text Lorem ipsum dolor sit amet, consectetur adipiscing elitr, sed diam nonumy eirmod tedundlabore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et erebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit am Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidulabore et dolore aliquayam erat, sed diam
            a.post_more(href="#") Read more

