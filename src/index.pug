doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="preconnect", href="https://fonts.googleapis.com")
        link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Roboto+Slab:wght@300..700&display=swap", rel="stylesheet")
        title Startup - Creative Agency Template
    body
        include components/mixins
        .overlay
        header#home
            div.wrapper.header_wrapper.menu_flex
                div.logo
                    a(href="index.html")
                        span.nazva Startup
                +menu(navigationMenu)

            div.hero.wrapper
                h1.hero_title Welcome to Startup
                p.hero_text Your Favourite Creative Agency Template
                a.btn(href="#services") Get started
        main
            section#services.section
                div.wrapper
                    div.section_head
                        h2.section_title Services
                        p.section_subtitle We offer ipsum dolor sit amet, consetetur sadipscing elitr amet
                    div.services
                        each info in servicesInfo
                            +service(info)

            section#about.section.section_gray
                div.wrapper
                    div.section_head
                        h2.section_title About us
                        p.section_subtitle Lorem ipsum dolor sit amet, consetetur sadipscing elitr amet
                    div.about_text
                        p Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sediam nonumy eirmod tempor invidunt ut labore et dolore aliquyam erat, sed diam voluptua. At vero eos et accusam et justo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet. Lorem ipsum dolor et dolore aliquyam erat. Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt.
                        p Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sediam nonumy eirtempor invidunt ut labore et dolore aliquyam erat, sed diam voluptua. At vero eos eaccusam et justo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet. Lorem ipsum dolor et dolore aliquyam erat. Loreipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod.
                    div.team
                        each info in teamInfo
                            +member(info)

            section#works.section
                div.wrapper
                    div.section_head
                        h2.section_title Latest works
                    ul.filter
                        li: a.active(href="#works") All
                        li: a(href="#works") Branding
                        li: a(href="#works") Design
                        li: a(href="#works") Development
                        li: a(href="#works") Strategy
                    div.works
                        each info in worksInfo
                            +work(info)

            section.cta
                div.wrapper
                    p.cta_text
                        | Do you like OUR WORK so far?
                        br
                        | Let's talk about YOUR PROJECT!
                    a.btn(href="#contact") Get in touch

            section#blog.section
                div.wrapper
                    div.section_head
                        h2.section_title Recent blog posts
                        p.section_subtitle Lorem ipsum dolor sit amet, consetetur sadipscing elitr amet
                    +post(postsInfo[0], { day: '18', month: 'Oct' })
                    +post(postsInfo[1], { day: '18', month: 'Oct' })

            section#clients.section.section_gray
                div.wrapper
                    div.clients
                        each logo in clientsInfo
                            img(src=`assets/images/${logo}`, alt="client logo")
                    div.quote
                        blockquote.quote_text Hvaing placeat facere possimus, omnis voluptas assumenda est, omnis dolor repellendus. Temporibus autem quibusdam et aut officiis debitis aut rerum"
                        p.quote_author John Doe, Google Inc.
                    div.dots
                        span.active
                        span
                        span

            section#contact.section
                div.wrapper
                    div.section_head
                        h2.section_title Get in touch
                        p.section_subtitle Lorem ipsum dolor sit amet, consetetur sadipscing elitr amet
                    div.contact
                        ul.contact_info
                            li
                                <svg viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
                                div
                                    h4 Address
                                    p 312, 7th Ave, New York
                                    p NY 101200, United States of America
                            li
                                <svg viewBox="0 0 24 24"><path fill-rule="evenodd" d="M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm4 17.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM8 5v11h8V5z"/></svg>
                                div
                                    h4 Hotline (24x7)
                                    p +65 0052 300, +65 88251 210
                                    p +88 01723 511 340
                            li
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 6l9 7 9-7"/></svg>
                                div
                                    h4 E-mail
                                    p shapedtheme@gmail.com
                                    p khalilkode@gmail.com
                        form.form(action="#")
                            input(type="text", placeholder="Your name")
                            input(type="email", placeholder="Your e-mail")
                            input(type="text", placeholder="Your subject")
                            input(type="text", placeholder="Company name")
                            textarea.form_wide(placeholder="Write your message")
                            div.form_bottom
                                button.btn.btn_dark(type="submit") Send message
                                p.form_note
                                    span *
                                    |  We'll contact you as as possible. We don't reply on Monday.
        footer
            div.wrapper
                div.footer_socials
                    +social
                    +social
                    +social
                    +social
                div.footer_line
                p.footer_p © 2015 Startup, designed by Shapedtheme

        script(type="module", src="./main.js")